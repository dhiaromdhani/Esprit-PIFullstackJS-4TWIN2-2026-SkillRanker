{
  "name": "backendv2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --coverage --runInBand --forceExit --passWithNoTests",
    "test:ci": "jest --coverage --runInBand --forceExit --passWithNoTests --reporters=default --reporters=jest-junit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@openrouter/sdk": "^0.5.1",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compromise": "^14.14.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "nodemailer": "^8.0.4",
    "openai": "^6.17.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-openidconnect": "^0.1.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/Tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/coverage.controller.js",
      "models/Activity.js",
      "models/ActivityRequest.js",
      "models/AuditLog.js",
      "models/Competence.js",
      "models/Department.js",
      "models/Employee.js",
      "models/EvaluationMessage.js",
      "models/Fiche.js",
      "models/Notification.js",
      "models/QuestionCompetence.js",
      "models/RecommendationHistory.js",
      "models/Session.js",
      "services/emailService.js",
      "services/embedding.service.js",
      "services/nlp.service.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 100,
        "statements": 100,
        "branches": 100,
        "functions": 100
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/routes/",
      "/middlewares/",
      "/config/",
      "/utils/",
      "/models/(ScoreApproval|Team|User)\\\\.js$",
      "/services/emailNotification\\\\.service\\\\.js$",
      "controllers[\\\\/](?!coverage\\.controller\\.js)"
    ]
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  }
}
